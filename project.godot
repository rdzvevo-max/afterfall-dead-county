[application]
config/name="AFTERFALL: DEAD COUNTY"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.018, 0.024, 0.02, 1)

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
reload={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73),Object(InputEventKey,"physical_keycode":4194308)]}
save_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194336)]}
load_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194340)]}
attack={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Loot"
